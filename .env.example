# MECHFIND Mobile Application Environment Configuration
# Copy this file to .env or pass variables via EAS Secrets

# Supabase Realtime & Database Backend
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps API Key for React Native Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Emergency Helpline
EXPO_PUBLIC_EMERGENCY_PHONE=1800-MECH-FIND

# Razorpay Key for React Native Mobile SDK
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Environment Mode (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

