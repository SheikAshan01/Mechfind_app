# Supabase Cloud Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional Google Maps Geocoding API Key (falls back to OpenStreetMap / browser GPS)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Emergency Support Helpline
NEXT_PUBLIC_EMERGENCY_PHONE=1800-MECH-FIND

# Razorpay India Payment Gateway (UPI / Cards / Netbanking)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# Stripe Payment Gateway (International Cards)
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Exotel Virtual Calling & Number Masking
EXOTEL_SID=your-exotel-sid
EXOTEL_TOKEN=your-exotel-token
EXOTEL_VIRTUAL_NUMBER=+918047192300

# WhatsApp Cloud API & Meta Business
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=100xxxxxxxxxx

# SMS Gateway (Fast2SMS / MSG91)
SMS_GATEWAY_API_KEY=your_sms_gateway_key

# Security: Disable sandbox one-click demo logins in production
NEXT_PUBLIC_DISABLE_DEMO_LOGIN=false

